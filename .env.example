# Google Cloud OAuth client (Web application).
# Add this exact redirect URI in Google Cloud:
# http://localhost:53682/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: pnpm google:auth
# Note: OAuth apps left in "Testing" mode expire refresh tokens after 7 days.
GOOGLE_REFRESH_TOKEN=

# Folder ID from https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=
